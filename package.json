{
  "name": "knoux-rec",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "KNOuX REC is a focused Windows desktop screen recorder with local, incremental recording persistence.",
  "keywords": [
    "screen-recorder",
    "screen-capture",
    "camera-recorder",
    "electron",
    "typescript",
    "react",
    "windows"
  ],
  "author": "KNOuX",
  "license": "MIT",
  "homepage": "https://github.com/daynightae-cmyk/knoux-rec",
  "repository": {
    "type": "git",
    "url": "https://github.com/daynightae-cmyk/knoux-rec.git"
  },
  "bugs": {
    "url": "https://github.com/daynightae-cmyk/knoux-rec/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build:audio-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop\\audio-helper\\build-helper.ps1",
    "build:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop\\ffmpeg\\build-runtime.ps1",
    "test:ffmpeg": "node scripts/ffmpeg-runtime-smoke.cjs",
    "test:export": "electron scripts/export-runtime-smoke.cjs",
    "test:project-export": "electron scripts/project-trim-export-smoke.cjs",
    "test:caption-srt": "node scripts/caption-srt-smoke.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:prod": "npm run build:audio-helper && npm run build:ffmpeg && npm run test:ffmpeg && npm run test:export && npm run test:project-export && npm run test:caption-srt && npm run type-check && npm run lint && npm test && npm run build",
    "desktop:pack": "npm run build:prod && electron-builder --dir --win",
    "desktop:dist": "npm run build:prod && electron-builder --win nsis",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.knoux.rec",
    "productName": "KNOuX REC",
    "artifactName": "KNOuX-REC-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "desktop/audio-helper/runtime/**",
      "desktop/ffmpeg/runtime/**"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KNOuX REC",
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
